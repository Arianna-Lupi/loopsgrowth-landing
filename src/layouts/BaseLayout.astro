---
import '../styles/global.css';
import { Font } from 'astro:assets';
import SkipLinks from '../components/SkipLinks.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { isProduction, canonicalUrl } from '../lib/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
const canonical = canonicalUrl('/');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!isProduction && <meta name="robots" content="noindex" />}
    {isProduction && canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <Font cssVariable="--font-brand" preload={[{ subset: "latin", style: "normal" }]} />
  </head>
  <body>
    <SkipLinks />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
