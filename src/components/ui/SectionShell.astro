---
/**
 * Envoltorio de sección que reutilizan los planes 03 a 06. Trae el tono (`data-tone`), el
 * `<h2>` con su barra decorativa (`.section-title`, en global.css), un lead opcional de
 * 60ch, el cuerpo por slot y un slot `cta` separado 48 px. Todo el color sale del tono:
 * este componente no declara colores propios. El texto llega como prop y se imprime como
 * nodo de texto (sin HTML en bruto).
 */
interface Props {
  id: string;
  tone: 'light' | 'yellow' | 'dark' | 'purple';
  title: string;
  lead?: string;
  titleId?: string;
}

const { id, tone, title, lead, titleId = `${id}-title` } = Astro.props;
const hasCta = Astro.slots.has('cta');
---

<section id={id} aria-labelledby={titleId} data-tone={tone} class="section-shell">
  <div class="wrap">
    <div class="section-head">
      <h2 id={titleId} class="section-title">{title}</h2>
      {lead && <p class="section-lead">{lead}</p>}
    </div>
    <div class="section-body"><slot /></div>
    {hasCta && <div class="section-cta"><slot name="cta" /></div>}
  </div>
</section>

<style>
  .section-shell {
    padding-block: var(--section-y);
  }

  .section-head,
  .section-cta {
    min-width: 0;
  }

  .section-lead {
    max-width: 60ch;
    margin-top: 1rem;
    overflow-wrap: anywhere;
  }

  .section-body {
    margin-top: 2rem;
    min-width: 0;
  }

  .section-cta {
    margin-top: 3rem;
  }

  @media (min-width: 40em) {
    .section-body {
      margin-top: 3rem;
    }
  }
</style>
