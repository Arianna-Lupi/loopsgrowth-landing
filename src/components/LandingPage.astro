---
/**
 * Plantilla de las landings nuevas (servicio, país, ciudad, nosotros y autora). Estructura de conversión en
 * bloques con ritmo de tonos (light, dark, yellow, purple; nunca dark junto a purple): hero con visual y marcas,
 * secciones en filas partidas, entregables en bento, proceso en pasos, medición, resultados (solo enlace a
 * `/#casos`, único lugar de casos), FAQ en `<details>` y cierre con la CTA única. Sin JavaScript, sin dirección,
 * mapa ni reseñas. Los logos, los pasos y la CTA salen del YAML verificado de la home; los `pendientes` nunca llegan aquí.
 * Ilustraciones: solo los assets de la web (Loopy, collage, fotos halftone, retratos del equipo).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaLink from './CtaLink.astro';
import { buildBreadcrumb } from '../lib/seo';
import { toBlocks } from '../lib/text';
import { siteUrl } from '../lib/site';
import { getLanding, ctaLabel } from '../lib/content';
import { CLIENT_LOGO_SIZE, CLIENT_LOGOS } from './sections/hero-clients.mjs';
import heroAi from '../assets/hero/hero-ai-search.webp';
import whynowA from '../assets/photos/treated/whynow-a.png';
import heroA from '../assets/photos/treated/hero-a.png';
import heroB from '../assets/photos/treated/hero-b.png';
import ojo from '../assets/brand/ojo-18-blanco.svg';
import ojoAmarillo from '../assets/brand/ojo-21-amarillo.svg';
import isotipo from '../assets/brand/isotipo-13-blanco.svg';

interface Props {
  kind: 'servicio' | 'pais' | 'ciudad' | 'nosotros' | 'autora';
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  h1: string;
  intro: string;
  secciones: { titulo: string; cuerpo: string }[];
  etapas?: { titulo: string; texto: string }[];
  entregables?: { titulo: string; texto: string }[];
  medicion?: { titulo: string; cuerpo: string; registro: string[] };
  equipo?: boolean;
  hechos?: { dato: string; fuente: string }[];
  faq?: { pregunta: string; respuesta: string }[];
  casos?: { texto: string; ancla: string };
  crumbs: { name: string; path: string }[];
  relacionados?: { href: string; label: string; texto: string }[];
  graph?: Record<string, unknown>[];
  ogType?: string;
}

const p = Astro.props;
const { kind, faq = [], hechos = [], relacionados = [], graph = [], etapas, entregables, medicion, casos } = p;
const base = siteUrl.replace(/\/+$/, '');
const data = await getLanding();
const label = ctaLabel(data);
const pageUrl = `${base}${p.path}`;

// Logos y pasos: los de la home (YAML verificado).
const logoFiles = import.meta.glob('../assets/clients/*.webp', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const clients = data.hero.clients.items.flatMap((item) => {
  const id = item.text.toLowerCase().replace(/\s+/g, '-');
  const src = logoFiles[`../assets/clients/${id}.webp`];
  return src && CLIENT_LOGOS.includes(id) ? [{ name: item.text, src }] : [];
});
const portraitFiles = import.meta.glob('../assets/team/treated/*.png', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const team = data.team.members.map((m, i) => {
  const id = ['arianna', 'veronica', 'juan', 'miguel'][i];
  return { name: m.name.text, role: m.role.text, src: portraitFiles[`../assets/team/treated/${id}.png`] };
});
const steps = data.how_it_works.steps;

const nodes: Record<string, unknown>[] = [buildBreadcrumb(base, p.crumbs, pageUrl), ...graph];
if (faq.length > 0) {
  nodes.push({
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta.replace(/\s*\n+\s*/g, ' ') } })),
  });
}
const schema = { '@context': 'https://schema.org', '@graph': nodes };

const introBlocks = toBlocks(p.intro);
const sub = introBlocks[0]?.kind === 'p' ? introBlocks[0].text : '';
const introRest = introBlocks.slice(1);
// Servicio: la 1.ª sección es el "qué es" con las etapas; el resto son filas partidas.
const [first, ...rest] = p.secciones;
// Solo el servicio de IA usa las fotos halftone; el resto, la mascota Loopy de la marca.
const rowVisuals = kind === 'servicio' ? [whynowA, heroA, heroB] : [ojo, isotipo, ojoAmarillo];
const rowTones = ['light', 'yellow', 'light'] as const;
const isService = kind === 'servicio';
const authorPortrait = team[0];
---

<BaseLayout title={p.title} description={p.description} path={p.path} noindex={p.noindex} schema={schema} ogType={p.ogType}>
  <article>
    <!-- Hero -->
    <section class="lp-hero" data-tone="light" aria-labelledby="lp-title">
      <div class="wrap">
        <nav aria-label="Ruta de navegación" class="crumbs">
          <ol>
            {p.crumbs.map((c, i) => (i === p.crumbs.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={c.path}>{c.name}</a></li>))}
          </ol>
        </nav>
        <div class="hero-grid">
          <div class="hero-copy">
            <h1 id="lp-title">{p.h1}</h1>
            <p class="hero-sub">{sub}</p>
            {introRest.map((b) => b.kind === 'p' && <p class="hero-more">{b.text}</p>)}
            <div class="hero-actions">
              <CtaLink label={label} location="pagina" href="/#agenda" />
              <a class="text-link" href="/#casos">Ver resultados</a>
            </div>
          </div>
          <div class="hero-visual" aria-hidden={kind === 'nosotros' ? undefined : 'true'}>
            {
              kind === 'nosotros' ? (
                <ul class="mosaic" role="list">
                  {team.map((m) => (
                    <li><Image src={m.src} alt={`Retrato de ${m.name}`} width={240} height={240} loading="eager" /></li>
                  ))}
                </ul>
              ) : kind === 'autora' ? (
                <div class="stage stage--orange"><Image src={authorPortrait.src} alt="" width={480} height={480} loading="eager" /></div>
              ) : (
                <div class="stage">
                  <Image src={heroAi} alt="" width={720} height={720} loading="eager" fetchpriority="high" />
                </div>
              )
            }
            {
              isService && (
                <div class="answer" role="img" aria-label="Ejemplo ilustrativo de una respuesta de asistente de IA con otras marcas mencionadas y la tuya citada">
                  <p class="answer-q">¿Qué agencia SEO me recomiendas para mi tienda online?</p>
                  <div class="answer-row"><span>Otra marca del sector</span><span class="answer-tag">Mencionada</span></div>
                  <div class="answer-row answer-row--you"><strong>Tu marca</strong><span class="answer-tag">Citada</span></div>
                  <small>Ejemplo ilustrativo. No es una respuesta real de ningún asistente.</small>
                </div>
              )
            }
          </div>
        </div>
        {
          clients.length > 0 && (
            <div class="proof">
              <p id="proof-label">{data.hero.clients.label.text}</p>
              <ul class="clients" role="list" aria-labelledby="proof-label">
                {clients.map((c) => (
                  <li><Image src={c.src} alt={c.name} width={CLIENT_LOGO_SIZE} height={CLIENT_LOGO_SIZE} loading="lazy" decoding="async" /></li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <!-- Servicio: qué es + etapas -->
    {
      first && (
        <section class="lp-section" data-tone="dark" aria-labelledby="s0-title">
          <div class="wrap">
            <h2 id="s0-title">{first.titulo}</h2>
            <div class="prose prose--wide">
              {toBlocks(first.cuerpo).map((b) => (b.kind === 'p' ? <p>{b.text}</p> : <ul>{b.items.map((i) => <li>{i}</li>)}</ul>))}
            </div>
            {
              etapas && (
                <ol class="stages" role="list" aria-label="Etapas de visibilidad en una respuesta de IA">
                  {etapas.map((e, i) => (
                    <li class:list={['stage-step', i === etapas.length - 2 && 'is-key']}>
                      <span class="stage-num" aria-hidden="true">{i + 1}</span>
                      <strong>{e.titulo}</strong>
                      <span>{e.texto}</span>
                    </li>
                  ))}
                </ol>
              )
            }
          </div>
        </section>
      )
    }

    <!-- Filas partidas -->
    {
      rest.map((s, i) => (
        <section class:list={['lp-section', 'split', i % 2 === 1 && 'split--flip']} data-tone={rowTones[i % rowTones.length]} aria-labelledby={`s${i + 1}-title`}>
          <div class="wrap split-grid">
            <div>
              <h2 id={`s${i + 1}-title`}>{s.titulo}</h2>
              <div class="prose">
                {toBlocks(s.cuerpo).map((b) => (b.kind === 'p' ? <p>{b.text}</p> : <ul>{b.items.map((li) => <li>{li}</li>)}</ul>))}
              </div>
            </div>
            <div class={`stage stage--${['yellow', 'purple', 'orange'][i % 3]} ${isService ? 'stage--art' : 'stage--contain stage--square'}`} aria-hidden="true">
              <Image src={rowVisuals[i % rowVisuals.length]} alt="" width={400} height={500} loading="lazy" decoding="async" />
            </div>
          </div>
        </section>
      ))
    }

    <!-- Entregables en bento -->
    {
      entregables && (
        <section class="lp-section" data-tone="yellow" aria-labelledby="ent-title">
          <div class="wrap">
            <h2 id="ent-title">Qué incluye el servicio</h2>
            <ul class="bento" role="list">
              {entregables.map((e, i) => (
                <li class:list={['bento-item', `bento-${i + 1}`]}>
                  {i === 0 && <Image class="bento-art" src={ojoAmarillo} alt="" width={120} height={120} aria-hidden="true" />}
                  <h3>{e.titulo}</h3>
                  <p>{e.texto}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Proceso (pasos verificados de la home) -->
    <section class="lp-section" data-tone="light" aria-labelledby="proc-title">
      <div class="wrap">
        <h2 id="proc-title">{data.how_it_works.title.text}</h2>
        <ol class="steps" role="list">
          {steps.map((st, i) => (
            <li class="step">
              <span class="step-n" aria-hidden="true">{i + 1}</span>
              <h3>{st.title.text}</h3>
              <p>{st.description.text}</p>
              <span class="pill">{st.timeframe.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Medición -->
    {
      medicion && (
        <section class="lp-section" data-tone="dark" aria-labelledby="med-title">
          <div class="wrap split-grid">
            <div>
              <h2 id="med-title">{medicion.titulo}</h2>
              <div class="prose">
                {toBlocks(medicion.cuerpo).map((b) => b.kind === 'p' && <p>{b.text}</p>)}
              </div>
            </div>
            <div class="panel">
              <Image class="panel-art" src={isotipo} alt="" width={96} height={96} aria-hidden="true" />
              <p class="panel-title">Cada mes registramos</p>
              <ul role="list">
                {medicion.registro.map((r) => (<li>{r}</li>))}
              </ul>
            </div>
          </div>
        </section>
      )
    }

    <!-- Equipo (Nosotros) -->
    {
      p.equipo && (
        <section class="lp-section" data-tone="dark" aria-labelledby="team-title">
          <div class="wrap">
            <h2 id="team-title">{data.team.title.text}</h2>
            <ul class="people" role="list">
              {team.map((m) => (
                <li>
                  <Image src={m.src} alt={`Retrato de ${m.name}`} width={240} height={240} loading="lazy" decoding="async" />
                  <strong>{m.name}</strong>
                  <span>{m.role}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Datos con fuente -->
    {
      hechos.length > 0 && (
        <section class="lp-section" data-tone="light" aria-labelledby="hechos-title">
          <div class="wrap">
            <h2 id="hechos-title">Datos que usamos</h2>
            <ul class="prose prose--wide facts">
              {hechos.map((h) => (<li>{h.dato} <a href={h.fuente} rel="noopener noreferrer">Fuente</a></li>))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Resultados: solo enlace a la home -->
    {
      casos && (
        <section class="lp-section" data-tone="yellow" aria-labelledby="res-title">
          <div class="wrap results">
            <div>
              <h2 id="res-title">Resultados</h2>
              <p class="prose">{casos.texto}</p>
            </div>
            <a class="btn-link" href="/#casos">{casos.ancla}</a>
          </div>
        </section>
      )
    }

    <!-- Relacionados -->
    {
      relacionados.length > 0 && (
        <section class="lp-section lp-section--tight" data-tone="light" aria-labelledby="rel-title">
          <div class="wrap">
            <h2 id="rel-title" class="h-sm">Sigue explorando</h2>
            <ul class="related" role="list">
              {relacionados.map((r) => (<li>{r.texto} <a href={r.href}>{r.label}</a></li>))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- FAQ -->
    {
      faq.length > 0 && (
        <section class="lp-section" data-tone="light" aria-labelledby="faq-title">
          <div class="wrap faq-grid">
            <h2 id="faq-title">Preguntas frecuentes</h2>
            <div class="faq-list">
              {faq.map((f) => (
                <details class="faq-item">
                  <summary>{f.pregunta}</summary>
                  <div class="faq-a">{toBlocks(f.respuesta).map((b) => (b.kind === 'p' ? <p>{b.text}</p> : <ul>{b.items.map((i) => <li>{i}</li>)}</ul>))}</div>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Cierre -->
    <section class="lp-section" data-tone="purple" aria-labelledby="cta-title">
      <div class="wrap closing">
        <div>
          <h2 id="cta-title">¿Quieres revisar tu caso?</h2>
          <p class="prose">Agenda una llamada con el equipo de Loops Growth y revisamos tu situación. Sin costo y sin compromiso.</p>
          <div class="hero-actions"><CtaLink label={label} location="pagina" href="/#agenda" /></div>
        </div>
        <div class="stage stage--yellow stage--contain" aria-hidden="true">
          <Image src={ojo} alt="" width={200} height={200} />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .lp-section { padding-block: var(--section-y); }
  .lp-section--tight { padding-block: 2rem; }
  .lp-section h2 { max-width: 22ch; margin-bottom: 1.5rem; letter-spacing: -0.02em; text-wrap: balance; }
  .lp-section h2.h-sm { font-size: var(--text-title); margin-bottom: 0.5rem; }
  .prose { max-width: 62ch; }
  .prose p, .prose ul { margin-block: 0 1rem; }
  .prose ul { padding-inline-start: 1.25rem; list-style: disc; }
  .prose a { color: var(--link); text-underline-offset: 4px; }
  .prose--wide { max-width: 70ch; }

  /* Hero */
  .lp-hero { padding-block: 1.5rem var(--section-y); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: var(--text-label); }
  .crumbs li + li::before { content: '/'; margin-inline-end: 0.5rem; }
  .crumbs a { display: inline-flex; align-items: center; min-height: var(--target-min); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  .hero-copy h1 { max-width: 16ch; letter-spacing: -0.03em; text-wrap: balance; }
  .hero-sub { max-width: 52ch; margin-top: 1.25rem; font-size: var(--text-title); line-height: 1.45; }
  .hero-more { max-width: 56ch; margin-top: 1rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin-top: 2rem; }
  .text-link { display: inline-flex; align-items: center; min-height: var(--target-min); font-weight: 600; color: var(--link); text-underline-offset: 4px; }
  .hero-visual { display: grid; gap: 0; min-width: 0; }
  .stage { position: relative; display: grid; place-items: center; overflow: hidden; border: var(--border-pop); border-radius: var(--radius-card); background: var(--color-brand-purple); box-shadow: var(--shadow-pop); aspect-ratio: 1; }
  .stage :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .stage--yellow { background: var(--color-brand-yellow); }
  .stage--orange { background: var(--color-brand-orange); }
  .stage--cream { background: var(--color-brand-cream); }
  .stage--contain :global(img) { width: 78%; height: 78%; object-fit: contain; }
  .stage--square { max-width: 20rem; }
  .stage--art { aspect-ratio: 4 / 5; max-width: 24rem; }
  .stage--art :global(img) { width: 80%; height: 80%; object-fit: contain; }
  .answer { position: relative; display: grid; gap: 0.75rem; margin: -2rem 1rem 0 -0.5rem; padding: 1.25rem; border: var(--border-pop); border-radius: var(--radius-card); background: var(--color-brand-white); color: var(--color-brand-dark); box-shadow: var(--shadow-pop); }
  .answer-q { font-weight: 600; }
  .answer-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.75rem; border-radius: var(--radius-s); background: var(--color-brand-cream); }
  .answer-row--you { outline: 3px solid var(--color-brand-purple); background: var(--color-brand-white); }
  .answer-tag { font-size: var(--text-label); font-weight: 600; color: var(--color-brand-purple); }
  .answer small { color: rgb(33 33 33 / 0.78); }
  .mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .mosaic :global(img) { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border: var(--border-pop); border-radius: var(--radius-card); box-shadow: var(--shadow-pop); }
  .mosaic li:nth-child(even) { transform: translateY(1.25rem); }
  .proof { display: grid; gap: 0.75rem; margin-top: 3rem; }
  .proof p { font-size: var(--text-label); font-weight: 600; }
  .clients { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .clients li { display: grid; place-items: center; min-width: 0; aspect-ratio: 5 / 3; padding: 0.5rem; border-radius: var(--radius-s); background: var(--color-brand-white); box-shadow: 0 0 0 1px rgb(33 33 33 / 0.12), 0 4px 16px rgb(0 0 0 / 0.05); }
  .clients :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }

  /* Etapas */
  .stages { display: grid; gap: 1rem; margin: 2.5rem 0 0; padding: 0; list-style: none; counter-reset: st; }
  .stage-step { display: grid; align-content: start; gap: 0.5rem; padding: 1.25rem; border-radius: var(--radius-card); background: rgb(255 255 255 / 0.06); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18); }
  .stage-step strong { font-size: var(--text-title); line-height: 1.3; }
  .stage-step span:last-child { color: rgb(255 255 255 / 0.85); }
  .stage-num { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: var(--radius-pill); background: var(--color-brand-yellow); color: var(--color-brand-dark); font-weight: 700; font-variant-numeric: tabular-nums; }
  .stage-step.is-key { background: var(--color-brand-yellow); color: var(--color-brand-dark); box-shadow: 4px 4px 0 var(--color-brand-orange); }
  .stage-step.is-key span:last-child { color: var(--color-brand-dark); }
  .stage-step.is-key .stage-num { background: var(--color-brand-dark); color: var(--color-brand-yellow); }

  /* Filas partidas */
  .split-grid { display: grid; gap: 2.5rem; align-items: center; }
  .split-grid > * { min-width: 0; }

  /* Bento */
  .bento { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .bento-item { position: relative; display: grid; align-content: start; gap: 0.5rem; padding: 1.5rem; border: var(--border-pop); border-radius: var(--radius-card); background: var(--color-brand-white); color: var(--color-brand-dark); }
  .bento-item h3 { color: inherit; }
  .bento-item p { max-width: 46ch; }
  .bento-1 { background: var(--color-brand-purple); color: var(--color-brand-white); box-shadow: var(--shadow-pop); }
  .bento-1 h3 { font-size: var(--text-heading); line-height: 1.15; max-width: 14ch; }
  .bento-art { width: 5rem; height: auto; margin-bottom: 0.5rem; }

  /* Pasos */
  .steps { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .step { display: grid; align-content: start; gap: 0.5rem; padding: 1.25rem; border-radius: var(--radius-card); background: var(--color-brand-cream); color: var(--color-brand-dark); box-shadow: 0 0 0 1px rgb(33 33 33 / 0.12), 0 8px 24px rgb(0 0 0 / 0.06); }
  .step h3 { color: inherit; }
  .step-n { font-size: 3rem; line-height: 1; font-weight: 700; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: var(--color-brand-purple); }
  .step .pill { justify-self: start; display: inline-flex; align-items: center; min-height: 1.75rem; padding: 0 0.75rem; border-radius: var(--radius-pill); background: var(--color-brand-white); font-size: var(--text-label); font-weight: 600; }

  /* Panel de medición */
  .panel { display: grid; gap: 0.75rem; padding: 1.5rem; border-radius: var(--radius-card); background: rgb(255 255 255 / 0.06); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18); }
  .panel-art { width: 3.5rem; height: auto; }
  .panel-title { font-size: var(--text-title); font-weight: 700; }
  .panel ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .panel li { padding: 0.75rem 1rem; border-radius: var(--radius-s); background: rgb(255 255 255 / 0.08); }

  .people { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
  .people li { display: grid; gap: 0.25rem; }
  .people :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-card); box-shadow: var(--shadow-pop); }
  .people span { font-size: var(--text-label); opacity: 0.85; }

  .results { display: grid; gap: 1.5rem; align-items: center; }
