---
/**
 * Quiénes somos (CONT-07). Tono yellow. Cuatro tarjetas pop en el orden del doc de Ari: retrato real en
 * duotono de marca (tres integrantes) o avatar Loopy (quien no tiene foto, hoy Miguel Pacheco), nombre y
 * cargo. La introducción y cada texto salen del YAML. Las tarjetas que tienen `link` son enlaces completos:
 * no muestran una URL literal y conservan el nombre visible dentro de su nombre accesible.
 *
 * Fotos: PNG locales de src/assets/team/treated (tratamiento en scripts/photos/treat-team.mjs, procedencia
 * en src/assets/team/PROVENANCE.md, puerta de producción en scripts/check-photos.mjs). Son decorativas
 * (`alt=""`): el nombre de la persona está en el `h3` de la misma tarjeta y repetirlo en el `alt` haría que
 * el lector de pantalla lo dijera dos veces (A11Y.md, imágenes decorativas o redundantes).
 */
import { Image } from 'astro:assets';
import SectionShell from '../ui/SectionShell.astro';
import Avatar from '../collage/Avatar.astro';
import { getLanding } from '../../lib/content';
import { TEAM_PHOTOS, TEAM_PHOTO_OUT, teamPhotoAt } from './team-photos.mjs';

const data = await getLanding();
// Los avatares y las fotos se asignan por posición desde aquí y no desde el YAML: una cadena suelta dentro
// de `es` rompe la guarda FND-02 (BARE_STRING). Los avatares solo cambian la cantidad de ojos y el color del
// disco; no son retratos.
const AVATARS = ['ojo-morado', 'ojo-amarillo', 'ojos-morado', 'ojos-amarillo'] as const;

const photos = import.meta.glob('../../assets/team/treated/*.png', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const photoSrc = (id: string) => {
  const src = photos[`../../assets/team/treated/${id}.png`];
  if (!src) throw new Error(`No existe la foto tratada del equipo "${id}" (ids: ${TEAM_PHOTOS.map((p) => p.id).join(', ')}).`);
  return src;
};
---

<SectionShell id="nosotros" tone="yellow" title={data.team.title.text} lead={data.team.intro.text}>
  <ul class="team-grid" role="list">
    {
      data.team.members.map((member, i) => {
        const photo = teamPhotoAt(i);
        return (
          <li class="team-card" data-tone="light">
            {member.link && (
              <a
                class="team-card-link"
                href={member.link.url.text}
                target="_blank"
                rel="noopener noreferrer"
                aria-labelledby={`team-member-${i}`}
                aria-describedby={`team-member-hint-${i}`}
              >
                <span id={`team-member-hint-${i}`} class="team-link-hint">{member.link.hint.text}</span>
              </a>
            )}
            <div class="team-avatar">
              {photo ? (
                <Image
                  class="team-photo"
                  src={photoSrc(photo.id)}
                  alt=""
                  width={TEAM_PHOTO_OUT}
                  height={TEAM_PHOTO_OUT}
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                  data-team-photo={photo.id}
                />
              ) : (
                <Avatar variant={AVATARS[i]} />
              )}
            </div>
            <h3 id={`team-member-${i}`}>{member.name.text}</h3>
            <p class="team-role">{member.role.text}</p>
          </li>
        );
      })
    }
  </ul>
</SectionShell>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--card-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Columna flexible: el enlace de una tarjeta no la hace más alta que las demás (la fila de la rejilla ya
     estira las cuatro al mismo alto) y el cargo queda siempre en la misma línea base entre fotos y avatar. */
  .team-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--card-pad);
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--on-surface);
    box-shadow: var(--shadow-pop);
    text-align: start;
  }

  .team-card-link {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
  }

  .team-card:has(.team-card-link) {
    cursor: pointer;
  }

  .team-card-link:hover {
    background: color-mix(in srgb, var(--color-brand-yellow) 16%, transparent);
  }

  .team-card-link:focus-visible {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .team-avatar {
    --team-box: 6rem;
    width: var(--team-box);
    aspect-ratio: 1;
    flex: none;
  }

  .team-avatar :global(svg) {
    width: 100%;
    /* El arte oficial trae aire propio a la izquierda (unos 7 %): se compensa para que el disco alinee con el nombre. */
    margin-inline-start: -6.7%;
  }

  /* Retrato: disco de las mismas medidas que el del avatar Loopy dentro de su caja (5/6 del lado, bajado un
     1/15 del lado y con la sombra dura al 5 % del lado), sin contorno como el collage. La imagen ya trae el color
     del disco en las luces (duotono), así que basta recortarla en círculo. Así las tarjetas con foto y la del avatar
     comparten disco, sombra y línea base. */
  .team-avatar :global(.team-photo) {
    display: block;
    width: 83.333%;
    height: auto;
    aspect-ratio: 1;
    margin-top: 6.667%;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: calc(var(--team-box) * 0.05) calc(var(--team-box) * 0.05) 0 var(--pop-shadow-color);
  }

  .team-card h3 {
    margin-top: 1rem;
    overflow-wrap: anywhere;
  }

  .team-role {
    margin-top: 0.5rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Solo para lectores de pantalla: ocupa 1 px y no aporta ancho ni altura visibles. */
  .team-link-hint {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 40em) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .team-avatar {
      --team-box: 7.5rem;
    }
  }

  @media (min-width: 64em) {
    .team-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* Reserva dos líneas de nombre: un nombre que baja de línea no desalinea los cargos de las otras tarjetas. */
    .team-card h3 {
      min-height: 2lh;
    }
  }
</style>
