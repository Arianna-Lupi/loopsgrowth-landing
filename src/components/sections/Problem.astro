---
/**
 * Sección bajo clientes / Bloqueadores de crecimiento (Inspo 2).
 * Tono dark. Encabezado centrado con el titular principal y lead explicativo,
 * seguido de 3 columnas con insignias hexagonales y texto de impacto.
 * Cierra con la afirmación destacada del equipo con 8 años de experiencia.
 */
import SectionShell from '../ui/SectionShell.astro';
import { getLanding } from '../../lib/content';

const data = await getLanding();
---

<SectionShell id="problema" tone="dark" title={data.problem.title.text} lead={data.problem.subtitle?.text}>
  <div class="blocker-container">
    <div class="blocker-grid">
      <div class="blocker-col">
        <div class="blocker-badge" aria-hidden="true">
          <svg class="blocker-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
            <path d="M11 8v6"></path>
            <path d="M8 11h6"></path>
          </svg>
        </div>
        <h3 class="blocker-heading">Google y Asistentes de IA</h3>
        <p class="blocker-text">
          {data.problem.items[0].text}
        </p>
      </div>

      <div class="blocker-col">
        <div class="blocker-badge" aria-hidden="true">
          <svg class="blocker-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"></path>
            <path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
            <path d="m13.4 10.6 2.6-2.6"></path>
            <path d="M6 12h2"></path>
            <path d="M16 12h2"></path>
            <path d="M12 6v2"></path>
          </svg>
        </div>
        <h3 class="blocker-heading">Ventas sin depender de Ads</h3>
        <p class="blocker-text">
          {data.problem.items[1].text}
        </p>
      </div>

      <div class="blocker-col">
        <div class="blocker-badge" aria-hidden="true">
          <svg class="blocker-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h3 class="blocker-heading">Equipo con 8 años</h3>
        <p class="blocker-text">
          {data.problem.items[2].text}
        </p>
      </div>
    </div>

    <div class="blocker-callout">
      <p class="blocker-callout-text">{data.problem.closing.text}</p>
    </div>
  </div>
</SectionShell>

<style>
  #problema :global(.section-head) {
    text-align: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  #problema :global(.section-title) {
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
    line-height: 1.2;
    color: var(--heading);
  }

  #problema :global(.section-lead) {
    margin-inline: auto;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 62ch;
    color: color-mix(in srgb, var(--on-surface) 80%, transparent);
  }

  .blocker-container {
    width: 100%;
    margin-top: 1.5rem;
  }

  .blocker-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 48em) {
    .blocker-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (min-width: 64em) {
    .blocker-grid {
      gap: 3.5rem;
    }
  }

  .blocker-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 0;
  }

  .blocker-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 1.25rem;
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--color-brand-yellow) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-yellow) 30%, transparent);
    color: var(--color-brand-yellow);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-brand-dark) 50%, transparent);
  }

  .blocker-icon {
    width: 1.75rem;
    height: 1.75rem;
  }

  .blocker-heading {
    margin: 0;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 700;
    color: var(--heading);
  }

  .blocker-text {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--on-surface) 80%, transparent);
    max-width: 40ch;
  }

  .blocker-callout {
    margin-top: 3.5rem;
    padding: 1.5rem 2rem;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-brand-purple) 22%, var(--surface));
    box-shadow: var(--shadow-pop);
    text-align: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  .blocker-callout-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--color-brand-white);
  }
</style>
