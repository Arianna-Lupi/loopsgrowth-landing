---
/**
 * Sección bajo clientes / Bloqueadores de crecimiento (Inspo 2).
 * Tono dark. Encabezado centrado con el titular principal y lead explicativo,
 * seguido de 3 columnas con insignias hexagonales y texto de impacto.
 * Cierra con la afirmación destacada del equipo con 8 años de experiencia.
 */
import SectionShell from '../ui/SectionShell.astro';
import CollageScene from '../collage/CollageScene.astro';
import { getLanding } from '../../lib/content';

const data = await getLanding();
---

<SectionShell id="problema" tone="dark" title={data.problem.title.text} lead={data.problem.subtitle?.text}>
  <div class="blocker-container">
    <div class="blocker-grid">
      <div class="blocker-col">
        <CollageScene scene="sticker-lupa" class="blocker-sticker" />
        <h3 class="blocker-heading">Google y Asistentes de IA</h3>
        <p class="blocker-text">
          {data.problem.items[0].text}
        </p>
      </div>

      <div class="blocker-col">
        <CollageScene scene="sticker-clic" class="blocker-sticker" />
        <h3 class="blocker-heading">Ventas sin depender de Ads</h3>
        <p class="blocker-text">
          {data.problem.items[1].text}
        </p>
      </div>

      <div class="blocker-col">
        <CollageScene scene="sticker-ojos" class="blocker-sticker" />
        <h3 class="blocker-heading">Equipo con 8 años</h3>
        <p class="blocker-text">
          {data.problem.items[2].text}
        </p>
      </div>
    </div>

    <div class="blocker-callout">
      <p class="blocker-callout-text">{data.problem.closing.text}</p>
    </div>
  </div>
</SectionShell>

<style>
  #problema :global(.section-head) {
    text-align: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  #problema :global(.section-title) {
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
    line-height: 1.2;
    color: var(--heading);
  }

  #problema :global(.section-lead) {
    margin-inline: auto;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 62ch;
    color: color-mix(in srgb, var(--on-surface) 80%, transparent);
  }

  .blocker-container {
    width: 100%;
    margin-top: 1.5rem;
  }

  .blocker-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 48em) {
    .blocker-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (min-width: 64em) {
    .blocker-grid {
      gap: 3.5rem;
    }
  }

  .blocker-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 0;
  }

  .blocker-sticker {
    width: 6rem;
    height: 5rem;
    margin-bottom: 1.25rem;
  }

  .blocker-heading {
    margin: 0;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 700;
    color: var(--heading);
  }

  .blocker-text {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--on-surface) 80%, transparent);
    max-width: 40ch;
  }

  .blocker-callout {
    margin-top: 3.5rem;
    padding: 1.5rem 2rem;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-brand-purple) 22%, var(--surface));
    box-shadow: var(--shadow-pop);
    text-align: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  .blocker-callout-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--color-brand-white);
  }
</style>
