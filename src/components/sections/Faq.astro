---
/**
 * FAQ (CONT-11). Tono yellow, con su propia sección (no usa SectionShell: el contrato pide h2 a la izquierda
 * y lista a la derecha desde 64em). Un `<details>` nativo por pregunta, sin `name` (no exclusivos) y sin `open`:
 * cerrados al cargar, se abren con Enter o Espacio y funcionan sin JavaScript. Sin transición de apertura.
 * Imprime solo `.text` de cada afirmación, sin leer su estado (COPY-01). Ganchos para el plan 07:
 * `faq-item`, `faq-summary`, `faq-answer`, `faq-icon` y `faq-icon-v`.
 */
import LangText from '../ui/LangText.astro';
import FaqItem from '../ui/FaqItem.astro';
import { getLanding } from '../../lib/content';
import { getFooterExplore } from '../../lib/nav';
import { getPosts } from '../../lib/blog';

const data = await getLanding();
const { faq, nav } = data;
// Enlaces internos del cuerpo de la home: páginas y artículos publicados, con sus nombres reales.
const pages = (await getFooterExplore()).filter((l) => !l.href.includes('#') && !l.href.startsWith('/equipo/'));
const posts = (await getPosts()).slice(0, 3).map((p) => ({ href: `/blog/${p.id}/`, label: p.data.title }));
const explore = [...pages, ...posts];
---

<section id="faq" aria-labelledby="faq-title" data-tone="light">
  <div class="wrap faq-grid">
    <h2 id="faq-title" class="section-title"><LangText text={faq.title.text} /></h2>
    <div class="faq-list">
      {
        faq.items.map((item) => (
          <FaqItem>
            <LangText slot="question" text={item.question.text} />
            <p><LangText text={item.answer.text} /></p>
          </FaqItem>
        ))
      }
    </div>
    {
      explore.length > 0 && (
        <nav class="faq-explore" aria-labelledby="explore-title">
          <h3 id="explore-title">{nav.explore_label.text}</h3>
          <ul role="list">
            {explore.map((l) => (
              <li><a href={l.href}><LangText text={l.label} /></a></li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</section>

<style>
  section {
    padding-block: var(--section-y);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .faq-grid > h2 {
    align-self: start;
    min-width: 0;
  }

  .faq-list {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .faq-explore {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .faq-explore ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .faq-explore a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 64em) {
    .faq-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 3rem;
      align-items: start;
    }
  }
</style>
