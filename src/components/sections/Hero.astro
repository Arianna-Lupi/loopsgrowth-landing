---
/**
 * Hero (CONT-01). Trae el único h1 de la página.
 * Orden DOM: h1, subtítulo, descripción (reubicada en la sección de bloqueadores), CTA (primario y secundario),
 * clientes y vitrina visual de arte al final del DOM (Inspo 1).
 */
import { Image } from 'astro:assets';
import CtaLink from '../CtaLink.astro';
import LangText from '../ui/LangText.astro';
import HeroCollage from '../collage/HeroCollage.astro';
import heroSearchImg from '../../assets/hero/hero-ai-search.webp';
import heroFounderImg from '../../assets/hero/hero-founder.webp';
import { getLanding, fill, textVars, ctaLabel } from '../../lib/content';
import { CLIENT_LOGO_SIZE, CLIENT_LOGOS } from './hero-clients.mjs';

const data = await getLanding();
const subtitle = fill(data.hero.subtitle, textVars(data), 'hero.subtitle');
const label = ctaLabel(data);

// Cada cliente se empareja con su logo por el nombre en minúsculas (src/assets/clients/<nombre>.webp).
const logos = import.meta.glob('../../assets/clients/*.webp', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const clients = data.hero.clients.items.map((item) => {
  const id = item.text.toLowerCase();
  const src = logos[`../../assets/clients/${id}.webp`];
  if (!src || !CLIENT_LOGOS.includes(id)) throw new Error(`Cliente "${item.text}" sin logo en src/assets/clients/ o fuera del manifiesto (ids: ${CLIENT_LOGOS.join(', ')}).`);
  return { name: item.text, id, src };
});
---

<section id="inicio" class="hero" aria-labelledby="hero-title" data-tone="light">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">{data.hero.h1.text}</h1>
      <p class="hero-sub"><LangText text={subtitle} /></p>
      <div class="hero-desc" aria-hidden="true" style="display: none;"></div>
      <div class="hero-cta">
        <CtaLink label={label} location="hero" />
        <a class="hero-secondary-btn" href="#casos">
          <span>Ver casos de éxito</span>
          <svg class="hero-secondary-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero-clients">
      <p class="hero-clients-label" id="hero-clients-label">{data.hero.clients.label.text}</p>
      <ul class="hero-clients-list" role="list" aria-labelledby="hero-clients-label">
        {
          clients.map((client) => (
            <li class="client-card" data-client={client.id}>
              <Image
                class="client-logo"
                src={client.src}
                alt=""
                width={CLIENT_LOGO_SIZE}
                height={CLIENT_LOGO_SIZE}
                loading="lazy"
                decoding="async"
                data-client-logo={client.id}
              />
              <span class="client-name">{client.name}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-art">
      <div class="hero-showcase">
        <div class="hero-card hero-card--main">
          <Image
            src={heroSearchImg}
            alt=""
            width={540}
            height={540}
            loading="eager"
            decoding="async"
            class="hero-card-img"
            data-hero-showcase="search"
          />
        </div>
        <div class="hero-card hero-card--founder">
          <Image
            src={heroFounderImg}
            alt=""
            width={440}
            height={440}
            loading="eager"
            decoding="async"
            class="hero-card-img"
            data-hero-showcase="founder"
          />
        </div>
      </div>
      <div class="hero-collage-fallback" aria-hidden="true" style="display: none;">
        <HeroCollage />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 3rem;
    padding-bottom: var(--section-y);
    overflow-x: clip;
    scroll-margin-top: 1.5rem;
  }

  @media (min-width: 64em) {
    .hero {
      padding-top: 4.5rem;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .hero-copy,
  .hero-art {
    min-width: 0;
  }

  .hero h1,
  .hero p {
    overflow-wrap: anywhere;
  }

  .hero-sub {
    max-width: 52ch;
    margin-top: 1.5rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.25rem);
    line-height: 1.6;
    font-weight: 400;
    color: var(--on-surface);
  }

  /* Botones alineados: primario y secundario */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .hero-secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--target-min);
    padding: 0.75rem 1.375rem;
    border: var(--border-pop);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-brand-dark);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 2px 2px 0 var(--color-brand-dark);
  }

  .hero-secondary-arrow {
    flex: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-secondary-btn {
      transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
    }
    .hero-secondary-btn:hover .hero-secondary-arrow {
      transform: translateX(3px);
      transition: transform var(--dur-1) var(--ease-out);
    }
  }

  .hero-secondary-btn:hover {
    background: var(--color-brand-dark);
    color: var(--color-brand-white);
  }

  .hero-secondary-btn:focus-visible {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* Vitrina visual (Inspo 1): composición de dos tarjetas con esquina redondeada y sombra pop */
  .hero-art {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-showcase {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 32rem;
    gap: 1.25rem;
  }

  .hero-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }

  .hero-card--main {
    flex: 1 1 55%;
    max-width: 19rem;
    z-index: 2;
  }

  .hero-card--founder {
    flex: 1 1 45%;
    max-width: 15rem;
    z-index: 1;
    margin-top: 1.5rem;
  }

  .hero-card-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  @media (min-width: 64em) {
    .hero-grid {
      grid-template-columns: minmax(0, 6.5fr) minmax(0, 5.5fr);
      align-items: center;
    }

    .hero-showcase {
      max-width: 36rem;
    }

    .hero-card--main {
      max-width: 21rem;
    }

    .hero-card--founder {
      max-width: 17rem;
      margin-top: 2.5rem;
    }
  }

  /* Clientes: debajo del hero, abarca todo el ancho */
  .hero-clients {
    min-width: 0;
  }

  .hero-clients-label {
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--on-surface);
  }

  .hero-clients-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .client-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.5rem 0.125rem 0.625rem;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: var(--color-brand-cream);
    color: var(--on-surface);
    box-shadow: var(--shadow-pop);
    text-align: center;
  }

  .client-card :global(.client-logo) {
    display: block;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-s);
    background: var(--color-brand-white);
    object-fit: cover;
  }

  .client-name {
    max-width: 100%;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  @media (min-width: 40em) {
    .hero-clients-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 48em) {
    .hero-clients-list {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1rem;
    }

    .client-card {
      padding: 0.75rem 0.5rem 0.875rem;
    }

    .client-card :global(.client-logo) {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  /* Móvil: orden secuencial: copy -> art -> clients */
  @media (max-width: 63.99em) {
    .hero-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      order: 1;
    }

    .hero-art {
      order: 2;
      margin-top: 2rem;
      margin-bottom: 2rem;
    }

    .hero-clients {
      order: 3;
      margin-top: 1rem;
    }
  }

  @media (min-width: 64em) {
    .hero-copy {
      grid-column: 1;
      grid-row: 1;
    }

    .hero-art {
      grid-column: 2;
      grid-row: 1;
    }

    .hero-clients {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 2rem;
    }
  }
</style>
