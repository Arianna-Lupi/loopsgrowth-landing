---
/**
 * Header mínimo, en el flujo normal (ni fijo ni pegado arriba) para no tapar el foco
 * (SC 2.4.11). El logo es la mesa 06 del vectorial de Ari (DSGN-02): sin enlace en `/` y con
 * enlace a `/` en cualquier otra ruta.
 * Monta el sprite del collage una sola vez por página, fuera del landmark (si BaseLayout lo
 * asume después, basta mover esa línea).
 * Por debajo de 640 px el CTA es una barra fija inferior que aparece al pasar el hero
 * (`cta-focus.ts` alterna `.is-visible`); oculto sale también del orden de tabulación.
 */
import CtaLink from './CtaLink.astro';
import Logo from './brand/Logo.astro';
import CollageSprite from './collage/CollageSprite.astro';
import { getLanding, ctaLabel } from '../lib/content';

const data = await getLanding();
const label = ctaLabel(data);
const isHome = Astro.url.pathname === '/';
const homeHref = isHome ? undefined : '/';
// En otras rutas `#agenda` no existe: el CTA lleva a la home con el ancla.
const ctaHref = isHome ? '#agenda' : '/#agenda';
// Un solo valor alimenta el tono del header y el del logo, para que no puedan separarse.
const tone = 'light';
---

<CollageSprite />

<header class="site-header" data-tone={tone}>
  <div class="wrap bar">
    <Logo name={data.brand.name.text} href={homeHref} tone={tone} />
    <div class="header-cta">
      <CtaLink label={label} location="header" href={ctaHref} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.75rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--on-surface) 8%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .header-cta {
    display: block;
    flex-shrink: 0;
  }

  /* Móvil: el CTA del header pasa a ser una barra fija inferior (el mismo enlace, sin duplicar CTA).
     Con JavaScript solo aparece cuando el CTA del hero ya salió de la pantalla y mientras no se vea
     el formulario ni el pie; sin JavaScript queda visible siempre. El `backdrop-filter` del header se
     apaga aquí porque crearía un bloque contenedor para el `position: fixed`. */
  @media (max-width: 39.99em) {
    .site-header {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      /* Sin desenfoque, un fondo translúcido deja ver el texto que pasa por debajo: aquí es opaco. */
      background: var(--surface);
    }

    .header-cta {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
      border-top: var(--border-pop);
      background: var(--color-brand-cream);
    }

    .header-cta :global(.cta) {
      width: 100%;
      min-height: 3rem;
    }

    :global(.site-header .brand-logo) {
      --logo-h: 28px;
    }
  }

  @media (max-width: 39.99em) and (scripting: enabled) {
    .header-cta:not(.is-visible) {
      visibility: hidden;
      transform: translateY(100%);
    }
  }

  @media (max-width: 39.99em) and (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .header-cta {
      transition:
        transform 260ms var(--ease-out),
        visibility 0s linear 260ms;
    }

    .header-cta.is-visible {
      transition:
        transform 260ms var(--ease-out),
        visibility 0s;
    }
  }
</style>
