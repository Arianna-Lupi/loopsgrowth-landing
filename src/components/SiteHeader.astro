---
/**
 * Header mínimo, en el flujo normal (ni fijo ni pegado arriba) para no tapar el foco
 * (SC 2.4.11). El logo es la mesa 06 del vectorial de Ari (DSGN-02): sin enlace en `/` y con
 * enlace a `/` en cualquier otra ruta.
 * Monta el sprite del collage una sola vez por página, fuera del landmark (si BaseLayout lo
 * asume después, basta mover esa línea).
 * Menú principal: `<nav>` con enlaces reales, sin JavaScript. Bajo 48em baja a una segunda fila del header
 * (que deja de ser pegajoso para no ocupar la pantalla); desde 48em va en línea entre el logo y la CTA.
 * El CTA se oculta con `display: none` por debajo de 640 px: así sale también del
 * orden de tabulación y el CTA del hero queda como único acceso en móvil.
 */
import CtaLink from './CtaLink.astro';
import Logo from './brand/Logo.astro';
import CollageSprite from './collage/CollageSprite.astro';
import { getLanding, ctaLabel } from '../lib/content';
import { getMainNav } from '../lib/nav';

const data = await getLanding();
const label = ctaLabel(data);
const links = await getMainNav();
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const isHome = Astro.url.pathname === '/';
const homeHref = isHome ? undefined : '/';
// En otras rutas `#agenda` no existe: el CTA lleva a la home con el ancla.
const ctaHref = isHome ? '#agenda' : '/#agenda';
// Un solo valor alimenta el tono del header y el del logo, para que no puedan separarse.
const tone = 'light';
---

<CollageSprite />

<header class="site-header" data-tone={tone}>
  <div class="wrap bar">
    <Logo name={data.brand.name.text} href={homeHref} tone={tone} />
    {
      links.length > 0 && (
        <nav class="main-nav" aria-label={data.nav.label.text}>
          <ul role="list">
            {links.map((l) => (
              <li>
                <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="header-cta">
      <CtaLink label={label} location="header" href={ctaHref} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.75rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--on-surface) 8%, transparent);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
  }

  .main-nav {
    order: 3;
    flex-basis: 100%;
    min-width: 0;
  }

  .main-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target-min);
    min-width: var(--target-min);
    color: var(--on-surface);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 600;
    text-decoration: none;
  }

  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .main-nav a:focus-visible {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  @media (max-width: 47.99em) {
    .site-header {
      position: static;
    }
  }

  @media (min-width: 48em) {
    .main-nav {
      order: 0;
      flex: 1 1 auto;
      display: flex;
      justify-content: center;
    }

    .main-nav ul {
      gap: 0 1.75rem;
    }
  }

  .header-cta {
    display: block;
    flex-shrink: 0;
  }

  @media (max-width: 26.5em) {
    .site-header {
      padding-block: 0.5rem;
    }
    .header-cta :global(.cta) {
      min-height: 2.25rem;
      padding: 0.25rem 0.625rem;
      font-size: 0.75rem;
      box-shadow: 2px 2px 0 var(--pop-shadow-color);
      white-space: nowrap;
    }
    :global(.site-header .brand-logo) {
      --logo-h: 24px;
    }
  }

  @media (min-width: 26.51em) and (max-width: 39.99em) {
    .header-cta :global(.cta) {
      min-height: 2.5rem;
      padding: 0.35rem 0.875rem;
      font-size: 0.8125rem;
      box-shadow: 2px 2px 0 var(--pop-shadow-color);
      white-space: nowrap;
    }
    :global(.site-header .brand-logo) {
      --logo-h: 28px;
    }
  }
</style>
