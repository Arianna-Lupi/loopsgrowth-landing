---
/**
 * Índice de resultados. Hero claro con el texto de lectura y una banda a ancho completo por caso, cada una con su tono
 * y su cifra gigante, que abre su ficha. Los datos salen del YAML de la home (misma fuente que la sección #casos).
 * Ritmo de tonos: light, purple, yellow, dark, yellow, purple (cierre).
 */
import Crumbs from './Crumbs.astro';
import Prose from './Prose.astro';
import Closing from './Closing.astro';
import { getLanding } from '../../lib/content';
import { toBlocks } from '../../lib/text';
import { CASO_SLUGS, CASO_TONES, casoPath } from '../../lib/casos';

interface Props { d: any; crumbs: { name: string; path: string }[] }
const { d, crumbs } = Astro.props;
const { cases } = await getLanding();
const paras = toBlocks(d.intro).filter((b) => b.kind === 'p').map((b: any) => b.text);
const [note] = d.secciones;
---

<article>
  <section class="hero" data-tone="light" aria-labelledby="hero-title">
    <div class="wrap">
      <Crumbs crumbs={crumbs} />
      <div class="grid">
        <div>
          <h1 id="hero-title" data-rv>{d.h1}</h1>
          {paras.map((t) => <p class="sub" data-rv>{t}</p>)}
        </div>
        <div class="note" data-rv data-rv-index="2"><h2>{note.titulo}</h2><Prose text={note.cuerpo} /></div>
      </div>
    </div>
  </section>

  {
    cases.items.map((c, i) => (
      <section class="band" data-tone={CASO_TONES[i]} aria-labelledby={`caso-${i}`}>
        <div class="wrap band-grid">
          <p class="n" aria-hidden="true" data-rv="count">{c.figure.text}</p>
          <div data-rv data-rv-index="1">
            <h2 id={`caso-${i}`}><span class="sr">{c.figure.text} </span>{c.metric.text}</h2>
            <p class="meta">{c.sector.text} · {c.period.text}</p>
            {c.detail && <p class="detail">{c.detail.text}</p>}
            <p class="act"><a class="btn-link" href={casoPath(CASO_SLUGS[i])}>Ver el caso<span class="sr"> de {c.sector.text}</span></a></p>
          </div>
        </div>
      </section>
    ))
  }

  <Closing tone="purple" title="¿Quieres revisar tu caso?" text="Agenda una llamada con el equipo de Loops Growth y revisamos tu situación. Sin costo y sin compromiso." />
</article>

<style>
  .hero { padding-block: 1.5rem var(--section-y); }
  .grid { display: grid; gap: 2rem; align-items: end; }
  h1 { max-width: 14ch; letter-spacing: -0.03em; text-wrap: balance; }
  .sub { max-width: 50ch; margin-top: 1.25rem; font-size: var(--text-title); line-height: 1.45; }
  .note { padding: 1.25rem; border-radius: var(--radius-card); background: var(--color-brand-cream); color: var(--color-brand-dark); box-shadow: 0 0 0 1px rgb(33 33 33 / 0.12), 0 8px 24px rgb(0 0 0 / 0.06); }
  .note h2 { font-size: var(--text-title); margin-bottom: 0.5rem; color: var(--color-brand-dark); }
  .band { padding-block: var(--section-y); }
  .band-grid { display: grid; gap: 1.5rem; align-items: center; }
  .n { margin: 0; font-size: clamp(3.5rem, 1.5rem + 9vw, 7.5rem); white-space: nowrap; line-height: 0.85; font-weight: 700; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; color: var(--heading); overflow-wrap: anywhere; }
  [data-tone='purple'] .n { color: var(--color-brand-yellow); }
  .band h2 { font-size: var(--text-heading); letter-spacing: -0.02em; max-width: 22ch; }
  .meta { margin-top: 0.75rem; font-weight: 600; }
  .detail { max-width: 52ch; margin-top: 0.75rem; }
  .act { margin-top: 1.5rem; }
  .btn-link { display: inline-flex; align-items: center; min-height: 3rem; padding: 0.5rem 1.5rem; border: var(--border-pop); border-radius: var(--radius-pill); background: var(--cta-bg); color: var(--on-cta); font-weight: 700; text-decoration: none; box-shadow: 4px 4px 0 var(--pop-shadow-color); }
  .btn-link:focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 64em) {
    .grid { grid-template-columns: 1.2fr 0.8fr; }
    .band-grid { grid-template-columns: 1.1fr 0.9fr; }
  }
</style>
