---
/**
 * Resultados reales: los 4 casos del YAML de la home (misma fuente, sin copy duplicado). Un caso protagonista y tres
 * en lista; ninguna rejilla de tarjetas iguales. El enlace lleva a la sección completa de la home (`/#casos`).
 */
import { getLanding } from '../../lib/content';
import { getLivePaths } from '../../lib/paginas';

interface Props { tone?: 'yellow' | 'light' | 'dark'; compact?: boolean }
const { tone = 'yellow', compact = false } = Astro.props;
const data = await getLanding();
const { cases } = data;
const live = await getLivePaths();
// Todo apunta a la sección de casos de la home, único lugar de casos (decisión Ari 17-nov-2026).
const allHref = '/#casos';
const hrefOf = (_i: number) => '/#casos';
const [lead, ...others] = cases.items;
const list = compact ? others.slice(0, 2) : others;
---

<section class="results" data-tone={tone} aria-labelledby="results-title">
  <div class="wrap">
    <div class="head" data-rv>
      <h2 id="results-title">{cases.title.text}</h2>
      <a class="all" href={allHref}>{data.nav.all_results.text}</a>
    </div>
    <div class="grid">
      <article class="lead" data-rv>
        <p class="n" data-rv="count">{lead.figure.text}</p>
        <div>
          <p class="metric">{lead.metric.text}</p>
          {lead.detail && <p>{lead.detail.text}</p>}
        </div>
        <p class="tag">{lead.sector.text} · {lead.period.text}</p>
        <a class="more" href={hrefOf(0)}>Ver el caso<span class="sr"> de {lead.sector.text}</span></a>
      </article>
      <ul role="list">
        {
          list.map((c, k) => (
            <li data-rv>
              <span class="n sm" data-rv="count">{c.figure.text}</span>
              <span class="body"><strong>{c.metric.text}</strong><small>{c.sector.text} · {c.period.text}</small><a class="more" href={hrefOf(k + 1)}>Ver el caso<span class="sr"> de {c.sector.text}</span></a></span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .results { padding-block: var(--section-y); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; margin-bottom: 2rem; }
  .head h2 { margin: 0; letter-spacing: -0.02em; }
  .all { display: inline-flex; align-items: center; min-height: var(--target-min); font-weight: 700; color: var(--link); text-underline-offset: 4px; }
  .grid { display: grid; gap: 1.5rem; }
  .lead { display: grid; align-content: space-between; gap: 1.5rem; padding: 1.75rem; border: var(--border-pop); border-radius: var(--radius-card); background: var(--color-brand-purple); color: var(--color-brand-white); box-shadow: var(--shadow-pop); }
  .n { margin: 0; font-size: clamp(3.5rem, 2rem + 7vw, 7rem); line-height: 0.9; font-weight: 700; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: var(--color-brand-yellow); }
  .metric { font-weight: 700; font-size: var(--text-title); }
  .tag { display: inline-flex; width: fit-content; padding: 0.25rem 0.75rem; border-radius: var(--radius-pill); background: var(--color-brand-cream); color: var(--color-brand-dark); font-size: var(--text-label); font-weight: 600; }
  ul { display: grid; margin: 0; padding: 0; list-style: none; align-content: start; }
  li { display: grid; grid-template-columns: minmax(5.5rem, auto) 1fr; gap: 0 1.25rem; align-items: center; padding-block: 1.25rem; border-top: var(--border-pop); }
  li:last-child { border-bottom: var(--border-pop); }
  .n.sm { font-size: var(--text-heading); line-height: 1; letter-spacing: -0.03em; color: var(--heading); }
  [data-tone='dark'] li, [data-tone='dark'] li:last-child { border-color: rgb(255 255 255 / 0.25); }
  [data-tone='dark'] .n.sm { color: var(--color-brand-yellow); }
  .body { display: grid; gap: 0.25rem; }
  .body small { font-size: var(--text-label); }
  .more { display: inline-flex; align-items: center; min-height: var(--target-min); width: fit-content; font-weight: 700; color: var(--color-brand-yellow); text-underline-offset: 4px; }
  li .more { color: var(--link); }
  [data-tone='dark'] li .more { color: var(--color-brand-yellow); }
  .more:focus-visible, .all:focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 64em) { .grid { grid-template-columns: 1.1fr 0.9fr; } }
</style>
