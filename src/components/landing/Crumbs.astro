---
interface Props { crumbs: { name: string; path: string }[] }
const { crumbs } = Astro.props;
---

<nav aria-label="Ruta de navegación" class="crumbs">
  <ol>
    {crumbs.map((c, i) => (i === crumbs.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={c.path}>{c.name}</a></li>))}
  </ol>
</nav>

<style>
  ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: var(--text-label); }
  li + li::before { content: '/'; margin-inline-end: 0.5rem; }
  a { display: inline-flex; align-items: center; min-height: var(--target-min); color: var(--link); }
</style>
