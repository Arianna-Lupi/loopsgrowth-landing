---
interface Props { crumbs: { name: string; path: string }[] }
const { crumbs } = Astro.props;
---

<nav aria-label="Ruta de navegación" class="crumbs">
  <ol>
    {crumbs.map((c, i) => (i === crumbs.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={c.path}>{c.name}</a></li>))}
  </ol>
</nav>

<style>
  ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: var(--text-label); }
  li { display: inline-flex; align-items: center; min-height: var(--target-min); line-height: 1.2; }
  li + li::before { content: '/'; margin-inline-end: 0.5rem; }
  a { color: var(--link); text-underline-offset: 4px; }
</style>
