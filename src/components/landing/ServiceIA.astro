---
/**
 * Servicio "posicionamiento en IA". Mundo de producto: hero oscuro con una ventana de chat ilustrativa, embudo de
 * visibilidad con barras decrecientes, bento de entregables, línea de tiempo vertical con título fijo y un panel de
 * medición tipo tabla. Ritmo de tonos: dark, light, yellow, light, dark, yellow, light, purple.
 */
import { Image } from 'astro:assets';
import CtaLink from '../CtaLink.astro';
import Crumbs from './Crumbs.astro';
import Prose from './Prose.astro';
import Logos from './Logos.astro';
import Results from './Results.astro';
import Faq from './Faq.astro';
import Closing from './Closing.astro';
import { getLanding, ctaLabel } from '../../lib/content';
import { toBlocks } from '../../lib/text';
import ojoAmarillo from '../../assets/brand/ojo-21-amarillo.svg';
import isotipo from '../../assets/brand/isotipo-13-blanco.svg';

interface Props { d: any; crumbs: { name: string; path: string }[] }
const { d, crumbs } = Astro.props;
const data = await getLanding();
const label = ctaLabel(data);
const sub = toBlocks(d.intro)[0];
const [que, decide, ...extra] = d.secciones;
const steps = data.how_it_works.steps;
---

<article>
  <section class="hero" data-tone="dark" aria-labelledby="hero-title">
    <div class="wrap">
      <Crumbs crumbs={crumbs} />
      <div class="hero-grid">
        <div>
          <h1 id="hero-title" data-rv>{d.h1}</h1>
          <p class="sub" data-rv>{sub.kind === 'p' ? sub.text : ''}</p>
          <p class="actions" data-rv><CtaLink label={label} location="pagina" href="/#agenda" /><a class="link" href="#etapas">Cómo funciona</a></p>
        </div>
        {
          d.chat && (
            <div class="chat" data-rv data-rv-index="1" role="img" aria-label="Conversación con un asistente de IA: otras marcas mencionadas y la tuya citada">
              <div class="chat-bar" aria-hidden="true"><span></span><span></span><span></span></div>
              <p class="bubble bubble--user" data-rv data-rv-index="3">{d.chat.pregunta}</p>
              <div class="bubble bubble--ai" data-rv data-rv-index="4">
                <ol>
                  {d.chat.filas.map((f: any) => (
                    <li class:list={[f.tu && 'you']}><span>{f.nombre}</span><em>{f.estado}</em></li>
                  ))}
                </ol>
              </div>
            </div>
          )
        }
      </div>
      <div class="logos-wrap" data-rv data-rv-index="2"><Logos /></div>
    </div>
  </section>

  <section id="etapas" class="funnel" data-tone="light" aria-labelledby="que-title">
    <div class="wrap">
      <div class="funnel-head">
        <h2 id="que-title" data-rv>{que.titulo}</h2>
        <div data-rv data-rv-index="1"><Prose text={que.cuerpo} /></div>
      </div>
      <ol class="bars" role="list" aria-label="Etapas de visibilidad en una respuesta de IA">
        {
          d.etapas.map((e: any, i: number) => (
            <li style={`--w:${100 - i * 17}%`}>
              <span class="bar" data-rv="grow" data-rv-index={String(i)}><b>{i + 1}</b><strong>{e.titulo}</strong></span>
              <span class="bar-text" data-rv data-rv-index={String(i)}>{e.texto}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bento-sec" data-tone="yellow" aria-labelledby="ent-title">
    <div class="wrap">
      <h2 id="ent-title" data-rv>Qué incluye el servicio</h2>
      <ul class="bento" role="list">
        {
          d.entregables.map((e: any, i: number) => (
            <li data-rv class={`b b${i + 1}`}>
              {i === 0 && <Image class="b-art" src={ojoAmarillo} alt="" width={96} height={96} aria-hidden="true" />}
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="timeline" data-tone="light" aria-labelledby="proc-title">
    <div class="wrap tl-grid">
      <div class="tl-head">
        <h2 id="proc-title" data-rv>{data.how_it_works.title.text}</h2>
        <div data-rv data-rv-index="1"><Prose text={decide.cuerpo} /></div>
      </div>
      <ol class="tl" role="list">
        {
          steps.map((st: any, i: number) => (
            <li data-rv-tl>
              <span class="dot" aria-hidden="true">{i + 1}</span>
              {i < steps.length - 1 && <span class="line" aria-hidden="true"></span>}
              <div class="tl-body">
                <h3>{st.title.text}</h3>
                <p>{st.description.text}</p>
                <span class="when">{st.timeframe.text}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="measure" data-tone="dark" aria-labelledby="med-title">
    <div class="wrap m-grid">
      <div>
        <h2 id="med-title" data-rv>{d.medicion.titulo}</h2>
        <div data-rv data-rv-index="1"><Prose text={d.medicion.cuerpo} /></div>
      </div>
      <div class="table" data-rv role="img" aria-label="Tabla mensual de medición">
        <div class="t-head"><Image src={isotipo} alt="" width={48} height={48} aria-hidden="true" /><strong>Batería mensual de prompts</strong></div>
        <ul role="list">
          {d.medicion.registro.map((r: string, i: number) => (<li data-rv><span class="t-n">{i + 1}</span>{r}</li>))}
        </ul>
      </div>
    </div>
  </section>

  {
    extra.length > 0 && (
      <section class="rows" data-tone="light" aria-label="Más sobre el posicionamiento en IA">
        <div class="wrap">
          {extra.map((e: any) => (
            <div class="row">
              <h2 data-rv>{e.titulo}</h2>
              <div data-rv data-rv-index="1"><Prose text={e.cuerpo} /></div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <Results tone="yellow" />
  <Faq items={d.faq} tone="light" />
  <Closing tone="purple" title="¿Quieres revisar tu caso?" text="Agenda una llamada con el equipo de Loops Growth y revisamos tu situación. Sin costo y sin compromiso." />
</article>

<style>
  section { padding-block: var(--section-y); }
  .row { display: grid; gap: 1rem; padding-block: 2rem; border-top: var(--border-pop); }
  .row:last-child { border-bottom: var(--border-pop); }
  .row h2 { max-width: 16ch; font-size: var(--text-heading); }
  @media (min-width: 64em) { .row { grid-template-columns: 0.9fr 1.1fr; gap: 3rem; align-items: start; } }
  h2 { letter-spacing: -0.02em; max-width: 20ch; margin-bottom: 1rem; text-wrap: balance; }
  .hero { padding-block: 1.5rem var(--section-y); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  h1 { max-width: 14ch; letter-spacing: -0.03em; text-wrap: balance; }
  .sub { max-width: 52ch; margin-top: 1.25rem; font-size: var(--text-title); line-height: 1.45; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin-top: 2rem; }
  .link { display: inline-flex; align-items: center; min-height: var(--target-min); font-weight: 600; color: var(--link); text-underline-offset: 4px; }
  .link:focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .logos-wrap { margin-top: 3rem; }
  .chat { display: grid; gap: 0.75rem; padding: 1rem; border: var(--border-pop); border-radius: var(--radius-card); background: var(--color-brand-white); color: var(--color-brand-dark); box-shadow: var(--shadow-pop); }
  .chat-bar { display: flex; gap: 0.375rem; padding-bottom: 0.25rem; }
  .chat-bar span { width: 0.625rem; height: 0.625rem; border-radius: 50%; background: rgb(33 33 33 / 0.2); }
  .bubble { margin: 0; padding: 0.75rem 1rem; border-radius: 1rem; }
  .bubble--user { justify-self: end; max-width: 85%; background: var(--color-brand-purple); color: var(--color-brand-white); border-bottom-right-radius: 0.25rem; font-weight: 600; }
  .bubble--ai { background: var(--color-brand-cream); border-bottom-left-radius: 0.25rem; }
  .bubble--ai ol { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .bubble--ai li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.75rem; border-radius: var(--radius-s); background: var(--color-brand-white); }
  .bubble--ai li.you { outline: 3px solid var(--color-brand-purple); font-weight: 700; }
  .bubble--ai em { font-style: normal; font-size: var(--text-label); font-weight: 600; color: var(--color-brand-purple); }
  .chat small { color: rgb(33 33 33 / 0.78); }

  .funnel-head { display: grid; gap: 1.5rem; margin-bottom: 2.5rem; }
  .bars { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .bars li { display: grid; gap: 0.5rem; }
  .bar { transform-origin: left center; display: flex; align-items: center; gap: 0.75rem; width: var(--w); min-width: 12rem; padding: 0.875rem 1.25rem; border: var(--border-pop); border-radius: var(--radius-pill); background: var(--color-brand-purple); color: var(--color-brand-white); }
  .bars li:nth-child(3) .bar { background: var(--color-brand-yellow); color: var(--color-brand-dark); box-shadow: var(--shadow-pop); }
  .bar b { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-brand-white); color: var(--color-brand-dark); font-variant-numeric: tabular-nums; }
  .bar strong { font-size: var(--text-title); }
  .bar-text { padding-inline: 0.5rem; max-width: 52ch; }

  .bento { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .b { display: grid; align-content: start; gap: 0.5rem; padding: 1.5rem; border: var(--border-pop); border-radius: var(--radius-card); background: var(--color-brand-white); color: var(--color-brand-dark); }
  .b h3 { color: inherit; }
  .b1 { background: var(--color-brand-purple); color: var(--color-brand-white); box-shadow: var(--shadow-pop); }
  .b1 h3 { font-size: var(--text-heading); line-height: 1.15; max-width: 14ch; }
  .b-art { width: 5rem; height: auto; }
  .b4 { background: var(--color-brand-dark); color: var(--color-brand-white); }

  .tl-grid { display: grid; gap: 2.5rem; }
  .tl { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; position: relative; }
  .tl li { position: relative; display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding-bottom: 2rem; }
  .line { position: absolute; left: 1.4375rem; top: 3rem; bottom: 0; width: 3px; background: var(--color-brand-dark); transform-origin: top center; }
  .dot { display: grid; place-items: center; width: 3rem; height: 3rem; border: var(--border-pop); border-radius: 50%; background: var(--color-brand-yellow); font-weight: 700; font-variant-numeric: tabular-nums; }
  .tl h3 { margin-bottom: 0.25rem; }
  .when { display: inline-flex; margin-top: 0.5rem; padding: 0.125rem 0.75rem; border-radius: var(--radius-pill); background: var(--color-brand-cream); font-size: var(--text-label); font-weight: 600; }

  .m-grid { display: grid; gap: 2.5rem; align-items: center; }
  .table { display: grid; gap: 0.75rem; padding: 1.25rem; border-radius: var(--radius-card); background: rgb(255 255 255 / 0.06); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.2); }
  .t-head { display: flex; align-items: center; gap: 0.75rem; font-size: var(--text-title); }
  .t-head :global(img) { width: 2.5rem; height: auto; }
  .table ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .table li { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: var(--radius-s); background: rgb(255 255 255 / 0.08); }
  .t-n { display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--color-brand-yellow); color: var(--color-brand-dark); font-weight: 700; font-size: var(--text-label); flex: none; }
  .table small { color: rgb(255 255 255 / 0.78); }

  @media (min-width: 40em) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .b1 { grid-column: 1 / -1; }
  }
  @media (min-width: 64em) {
    .hero-grid { grid-template-columns: 1fr 1fr; }
    .funnel-head { grid-template-columns: 1fr 1fr; align-items: start; }
    .bento { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .b1 { grid-column: 1 / span 2; grid-row: 1 / span 2; align-content: end; }
    .b2, .b3 { grid-column: span 2; }
    .tl-grid { grid-template-columns: 0.8fr 1.2fr; align-items: start; }
    .tl-head { position: sticky; top: 1.5rem; }
    .m-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
