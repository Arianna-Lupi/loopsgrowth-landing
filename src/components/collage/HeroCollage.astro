---
/**
 * HeroCollage (DSGN-03). Collage pop de línea gruesa, decorativo y autocontenido: SVG en línea,
 * sin texto, sin <title>, sin imágenes y sin degradados. Los colores salen solo de tokens
 * (`--color-brand-*` y `--collage-stroke`, este último cambia con el tono de la sección).
 * Seis piezas agrupadas y nombradas para que el plan 07 anime la entrada sin reestructurar:
 * `--i` (orden 0 a 5), `--r` y `--r-from` (grados). En este plan no hay animación.
 * Las transformaciones geométricas van en un <g> interior; el <g class="hc-piece"> exterior
 * queda libre para el `transform` de CSS de la entrada.
 */
---

<svg
  class="hero-collage"
  viewBox="0 0 560 520"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <pattern id="hc-dots" width="18" height="18" patternUnits="userSpaceOnUse">
      <circle class="hc-dot" cx="9" cy="9" r="3"></circle>
    </pattern>
  </defs>

  <g class="hc-piece" data-piece="loops" style="--i:0;--r:0;--r-from:-30">
    <circle class="hc-orange" cx="335" cy="215" r="195"></circle>
    <circle class="hc-yellow" cx="335" cy="215" r="158"></circle>
    <circle class="hc-orange" cx="335" cy="215" r="121"></circle>
  </g>

  <g class="hc-piece" data-piece="lupa" style="--i:1;--r:0;--r-from:8">
    <rect class="hc-dark" x="389" y="245" width="155" height="40" rx="20" transform="rotate(45 265 265)"></rect>
    <circle class="hc-purple" cx="265" cy="265" r="130"></circle>
    <circle class="hc-white" cx="265" cy="265" r="104"></circle>
    <path d="M188 237A82 82 0 0 1 237 188"></path>
  </g>

  <g class="hc-piece" data-piece="ojos" style="--i:2;--r:-4;--r-from:-14">
    <g transform="translate(34 26) scale(1.4)">
      <ellipse class="hc-white" cx="32" cy="32" rx="30" ry="28"></ellipse>
      <ellipse class="hc-white" cx="90" cy="32" rx="30" ry="28"></ellipse>
      <circle class="hc-pupil" cx="24" cy="40" r="11"></circle>
      <circle class="hc-pupil" cx="82" cy="40" r="11"></circle>
    </g>
  </g>

  <g class="hc-piece" data-piece="clic-a" style="--i:3;--r:0;--r-from:12">
    <g transform="translate(150 372) rotate(90) scale(1.5)">
      <path class="hc-purple" d="M0 0V40l10-9 8 17 9-4-8-16h14z"></path>
      <path d="M-9-4l-9-3M-4-9l-3-9M-8-8l-8-8"></path>
    </g>
  </g>

  <g class="hc-piece" data-piece="clic-b" style="--i:4;--r:0;--r-from:-12">
    <g transform="translate(452 150) rotate(-90) scale(1.5)">
      <path class="hc-white" d="M0 0V40l10-9 8 17 9-4-8-16h14z"></path>
      <path d="M-9-4l-9-3M-4-9l-3-9M-8-8l-8-8"></path>
    </g>
  </g>

  <g class="hc-piece" data-piece="destellos" style="--i:5;--r:0;--r-from:20">
    <rect class="hc-patch" x="18" y="432" width="126" height="72"></rect>
    <path d="M40 290v28M26 304h28"></path>
    <path d="M530 40v28M516 54h28"></path>
    <path class="hc-plus-purple" d="M516 430v28M502 444h28"></path>
    <path class="hc-plus-purple" d="M262 22v28M248 36h28"></path>
  </g>
</svg>

<style>
  .hero-collage {
    display: block;
    max-width: 100%;
    fill: none;
    stroke: var(--collage-stroke);
    stroke-width: 3px;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* El trazo se mantiene en 3 px de pantalla al escalar el viewBox (contrato de marca). */
  .hero-collage :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .hc-yellow {
    fill: var(--color-brand-yellow);
  }
  .hc-orange {
    fill: var(--color-brand-orange);
  }
  .hc-purple {
    fill: var(--color-brand-purple);
  }
  .hc-white {
    fill: var(--color-brand-white);
  }
  .hc-pupil,
  .hc-dark {
    fill: var(--color-brand-dark);
  }
  .hc-dot {
    fill: var(--color-brand-purple);
    stroke: none;
  }
  .hc-patch {
    fill: url(#hc-dots);
    stroke: none;
  }
  .hc-plus-purple {
    stroke: var(--color-brand-purple);
  }
</style>
