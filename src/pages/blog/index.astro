---
/**
 * Índice del blog (modo Leer). Sin artículos publicados la página queda `noindex`, no entra al sitemap y
 * muestra un estado vacío honesto. Un solo h1; la lista es una lista real, un `<article>` por entrada.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, AUTHORS } from '../../lib/blog';
import { buildBreadcrumb } from '../../lib/seo';
import { siteUrl } from '../../lib/site';

const posts = await getPosts();
const base = siteUrl.replace(/\/+$/, '');
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [buildBreadcrumb(base, crumbs, `${base}/blog/`)],
};
---

<BaseLayout
  title="Blog de SEO y GEO: Loops Growth"
  description="Guías de SEO y GEO escritas por Arianna Lupi para marcas y negocios que quieren crecer en Google y en asistentes de IA."
  path="/blog/"
  noindex={posts.length === 0}
  schema={schema}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Blog de Loops Growth" href="/blog/rss.xml" />
  <section class="blog-index" aria-labelledby="blog-title" data-tone="light">
    <div class="wrap">
      <nav aria-label="Ruta de navegación" class="crumbs">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li aria-current="page">Blog</li>
        </ol>
      </nav>
      <h1 id="blog-title">Blog</h1>
      {
        posts.length === 0 ? (
          <p class="empty">Estamos preparando las primeras guías. Vuelve pronto.</p>
        ) : (
          <ul class="post-list" role="list">
            {posts.map((post) => (
              <li>
                <article class="post-card">
                  <h2>
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                  <p class="meta">
                    {AUTHORS[post.data.author].name} · <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  </p>
                  <p>{post.data.description}</p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding-block: var(--section-y);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--text-label);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    line-height: 1.2;
  }
  .crumbs li + li::before {
    content: '/';
    margin-inline-end: 0.5rem;
  }
  .empty {
    margin-top: 1.5rem;
  }
  .post-list {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .post-card {
    padding: 1.25rem;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: var(--color-brand-cream);
    box-shadow: var(--shadow-pop);
  }
  .post-card h2 {
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
  }
  .post-card h2 a {
    display: inline-block;
    min-height: var(--target-min);
    color: inherit;
  }
  .meta {
    margin-block: 0.25rem 0.75rem;
    font-size: var(--text-label);
  }
</style>
