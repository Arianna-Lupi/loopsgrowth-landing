---
/**
 * Artículo del blog (modo Leer). Un solo h1 (el título), medida de lectura de 65ch, migas con datos
 * estructurados, firma de Ari y cierre con enlaces a las páginas de servicio (nunca precios).
 * Un borrador (solo visible fuera de producción) sale `noindex`.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import ariPhoto from '../../assets/team/treated/arianna.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaLink from '../../components/CtaLink.astro';
import { getPosts, formatDate, AUTHORS } from '../../lib/blog';
import { buildArticleSchema } from '../../lib/seo';
import { siteUrl } from '../../lib/site';
import { getLanding, ctaLabel } from '../../lib/content';
import { getLivePaths } from '../../lib/paginas';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// Tabla de contenidos: solo los h2 del artículo. Astro les asigna el id (slug) al renderizar el Markdown.
const toc = headings.filter((h) => h.depth === 2);
const author = AUTHORS[post.data.author];
// Con la página de autora en este build, la firma y el schema apuntan a ella; si no, al sitio de Ari.
const authorPage = (await getLivePaths()).has('/equipo/arianna-lupi/') ? '/equipo/arianna-lupi/' : undefined;
const authorHref = authorPage ?? author.url;
const path = `/blog/${post.id}/`;
const data = await getLanding();
const label = ctaLabel(data);
const schema = buildArticleSchema({
  siteUrl,
  path,
  title: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate,
  dateModified: post.data.updatedDate,
  authorName: author.name,
  authorUrl: authorPage ? new URL(authorPage, siteUrl).href : author.url,
  breadcrumbs: [
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: post.data.title, path },
  ],
});
---

<BaseLayout
  reveal
  title={`${post.data.title} | Loops Growth`}
  description={post.data.description}
  path={path}
  ogType="article"
  noindex={post.data.draft}
  schema={schema}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Blog de Loops Growth" href="/blog/rss.xml" />
  <article class="post" data-tone="light" aria-labelledby="post-title">
    <div class="wrap">
      <nav aria-label="Ruta de navegación" class="crumbs">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li aria-current="page">{post.data.title}</li>
        </ol>
      </nav>
      <header>
        <h1 id="post-title" data-rv>{post.data.title}</h1>
        <p class="meta" data-rv>
          Por <a href={authorHref} rel="author">{author.name}</a>, {author.role}.{' '}
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.updatedDate && (
            <>
              . Actualizado el <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>
            </>
          )}
        </p>
      </header>
      <div class="layout">
        <div class="main-col">
          {
            toc.length > 1 && (
              <details class="toc toc--mobile" data-rv>
                <summary>En este artículo</summary>
                <ol>
                  {toc.map((h) => (
                    <li><a href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ol>
              </details>
            )
          }
          <div class="prose">
            <Content />
          </div>
          <aside class="author-box" data-rv aria-label="Sobre la autora">
            <Image src={ariPhoto} alt="" width={96} height={96} loading="lazy" decoding="async" />
            <div>
              <p class="author-name">{author.name}</p>
              <p>{author.role}. Más de 8 años de experiencia en SEO y fundadora de la academia aprendoclub.</p>
              {authorPage && <a href={authorPage}>Conoce a la autora</a>}
            </div>
          </aside>
          <aside class="post-cta post-cta--end" aria-labelledby="post-cta-title">
            <h2 id="post-cta-title">¿Quieres revisar tu caso?</h2>
            <p>Agenda una llamada con el equipo de Loops Growth.</p>
            <CtaLink label={label} location="blog" href="/#agenda" />
          </aside>
        </div>
        <aside class="side" data-rv data-rv-index="2" aria-label="Contenido y acción del artículo">
          {
            toc.length > 1 && (
              <nav class="toc toc--side" aria-labelledby="toc-title">
                <h2 id="toc-title">En este artículo</h2>
                <ol>
                  {toc.map((h) => (
                    <li><a href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="side-cta">
            <p class="side-cta-title">¿Quieres que lo hagamos por ti?</p>
            <p>Cuéntanos tu caso en una llamada y te decimos qué haría falta.</p>
            <CtaLink label={label} location="blog" href="/#agenda" />
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--section-y);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--text-label);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    line-height: 1.2;
  }
  .crumbs li + li::before {
    content: '/';
    margin-inline-end: 0.5rem;
  }
  .post h1 {
    max-width: 24ch;
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
  }
  .meta {
    margin-block: 1rem 2rem;
    font-size: var(--text-label);
  }
  .prose {
    max-width: 65ch;
  }
  .prose :global(h2) {
    scroll-margin-top: 6.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 1rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.5rem;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-block: 0.5rem;
  }
  .prose :global(table) {
    width: 100%;
    margin-block: 1.5rem;
    border-collapse: collapse;
    font-size: var(--text-label);
  }
  .prose :global(th),
  .prose :global(td) {
    min-width: 0;
    padding: 0.5rem 0.5rem;
    overflow-wrap: anywhere;
    border: 2px solid var(--color-brand-dark);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .layout {
    display: grid;
    gap: 2rem;
  }
  .main-col {
    min-width: 0;
  }
  .side {
    display: none;
  }
  .toc--mobile {
    margin-bottom: 1.5rem;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: var(--color-brand-cream);
  }
  .toc--mobile summary {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    padding: 0.5rem 1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .toc ol {
    margin: 0;
    padding: 0 1rem 0.75rem 2.25rem;
    list-style: decimal;
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--link);
    text-underline-offset: 4px;
  }
  .toc--side h2 {
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
  }
  .side-cta {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: var(--color-brand-cream);
    box-shadow: var(--shadow-pop);
  }
  .side-cta p {
    margin-block: 0 0.75rem;
  }
  .side-cta-title {
    font-weight: 700;
  }
  @media (min-width: 64em) {
    .layout {
      grid-template-columns: minmax(0, 65ch) 18rem;
      justify-content: space-between;
      align-items: start;
    }
    .side {
      display: block;
      position: sticky;
      top: 6.5rem;
    }
    .toc--mobile {
      display: none;
    }
    .post-cta--end {
      display: none;
    }
    .toc--side ol {
      padding: 0.5rem 0 0 1.25rem;
    }
  }
  .prose :global(blockquote) {
    margin: 0 0 1.5rem;
    padding: 1.25rem;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: var(--color-brand-yellow);
    color: var(--color-brand-dark);
    box-shadow: var(--shadow-pop);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .author-box {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    align-items: center;
    max-width: 65ch;
    margin-top: 2.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-card);
    background: var(--color-brand-cream);
    box-shadow: 0 0 0 1px rgb(33 33 33 / 0.12), 0 8px 24px rgb(0 0 0 / 0.06);
  }
  .author-box :global(img) {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: var(--radius-card);
  }
  .author-name {
    font-weight: 700;
  }
  .author-box a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--link);
    text-underline-offset: 4px;
  }
  .post-cta {
    max-width: 65ch;
    margin-top: 3rem;
    padding: 1.5rem;
    border: var(--border-pop);
    border-radius: var(--radius-card);
    background: var(--color-brand-cream);
    box-shadow: var(--shadow-pop);
  }
  .post-cta p {
    margin-block: 0.5rem 1rem;
  }
</style>
