---
/**
 * Hoja de revisión visual de la marca (herramienta interna, no es copy de la landing).
 * Existe solo fuera de producción: con PUBLIC_ENV=production `getStaticPaths` devuelve una lista
 * vacía y no se genera `/marca/hoja/`. Lleva `noindex` por BaseLayout. Los rótulos son ids de
 * pieza en elementos `code`, nunca frases. Sirve para que Juan y Ari aprueben logo, isotipo,
 * primitivas de collage, composiciones y avatares a varios anchos antes de que existan las
 * secciones que los usan.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/brand/Logo.astro';
import CollagePiece from '../../components/collage/CollagePiece.astro';
import { PIECES, ALLOWED_FILLS } from '../../components/collage/collage-rules.mjs';
import { isProduction } from '../../lib/site';
import { getLanding } from '../../lib/content';

export function getStaticPaths() {
  return isProduction ? [] : [{ params: { sheet: 'hoja' } }];
}

const data = await getLanding();
const name = data.brand.name.text;
const TONES = ['light', 'dark'] as const;
const PIECE_TONES = ['light', 'yellow', 'dark', 'purple'] as const;
// Combinación de colores por tono: siempre dentro de ALLOWED_FILLS y sin repetir el color del fondo.
const COMBOS = {
  light: { a: 'yellow', b: 'purple', c: 'orange' },
  yellow: { a: 'white', b: 'purple', c: 'orange' },
  dark: { a: 'yellow', b: 'orange', c: 'white' },
  purple: { a: 'yellow', b: 'orange', c: 'white' },
} as const;
const pieceNames = Object.keys(PIECES);
const SIZES: Record<string, string> = { lupa: '10rem', loop: '8rem', puntos: '6rem', 'ojos-izq': '7.5rem', 'ojos-der': '7.5rem', 'ojos-abajo': '7.5rem' };
---

<BaseLayout title="hoja de marca">
  <div class="sheet">
    <div class="wrap">
      <h1><code>marca/hoja</code></h1>
    </div>

    <section aria-labelledby="sheet-identity" class="sheet-block" data-sheet="identidad">
      <div class="wrap">
        <h2 id="sheet-identity"><code>identidad</code></h2>
        <div class="sheet-grid">
          {
            TONES.map((tone) => (
              <div class="sheet-tone" data-tone={tone}>
                <p><code>logo-horizontal / {tone}</code></p>
                <Logo class="sheet-zone" name={name} variant="horizontal" />
                <p><code>isotipo / {tone}</code></p>
                <Logo class="sheet-zone" name={name} variant="isotipo" />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      PIECE_TONES.map((tone) => (
        <section class="sheet-band" data-tone={tone} data-sheet="primitivas" aria-labelledby={`sheet-prim-${tone}`}>
          <div class="wrap">
            <h2 id={`sheet-prim-${tone}`}>
              <code>primitivas / {tone}</code>
            </h2>
            <ul class="sheet-pieces">
              {pieceNames
                .filter((piece) => {
                  const fixed = PIECES[piece].fixed;
                  return !fixed || ALLOWED_FILLS[tone].includes(fixed);
                })
                .map((piece) => (
                  <li>
                    <CollagePiece name={piece} tone={tone} size={SIZES[piece]} {...COMBOS[tone]} />
                    <code>{piece}</code>
                  </li>
                ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .sheet {
    padding-block: 2rem;
  }

  .sheet-block {
    margin-top: 2rem;
  }

  .sheet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .sheet-tone {
    min-width: 0;
    padding: 1rem;
    border: 3px solid var(--color-brand-dark);
    border-radius: var(--radius-card, 1rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .sheet-band {
    margin-top: 2rem;
    padding-block: 2rem;
  }

  .sheet-pieces {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: 1.5rem;
  }

  .sheet-pieces li {
    min-width: 0;
    min-height: 12.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .sheet code {
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  /* El padding del propio logo dibuja el área de salvado (1 X del BrandBook, página 7). */
  .sheet :global(.sheet-zone) {
    padding: var(--logo-clear);
    border: 2px dashed currentColor;
    max-width: 100%;
    box-sizing: border-box;
  }
</style>
