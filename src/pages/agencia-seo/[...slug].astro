---
/**
 * Hub y páginas de país de `/agencia-seo/` (SEO programático, borrador para Ari).
 * Control de index bloat: sin países publicados no se genera nada (ni hub); el hub solo existe si hay al menos
 * un país. Un país en borrador (solo visible fuera de producción) sale `noindex`. Sin LocalBusiness, sin
 * dirección ni oficina y sin reseñas: Loops no tiene presencia física en ningún país. Cada país aporta
 * secciones y hechos propios con fuente; el texto compartido vive en `src/lib/pais-template.json`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaLink from '../../components/CtaLink.astro';
import { getPaises, PAIS_TEMPLATE } from '../../lib/paises';
import { buildBreadcrumb } from '../../lib/seo';
import { siteUrl } from '../../lib/site';
import { getLanding, ctaLabel } from '../../lib/content';

export async function getStaticPaths() {
  const paises = await getPaises();
  if (paises.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { kind: 'hub', pais: null, paises } },
    ...paises.map((pais) => ({ params: { slug: pais.id }, props: { kind: 'pais', pais, paises } })),
  ];
}

const { kind, pais, paises } = Astro.props;
const base = siteUrl.replace(/\/+$/, '');
const data = await getLanding();
const label = ctaLabel(data);
const isHub = kind === 'hub';
const path = isHub ? '/agencia-seo/' : `/agencia-seo/${pais!.id}/`;
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Agencia SEO', path: '/agencia-seo/' },
  ...(isHub ? [] : [{ name: pais!.data.nombre, path }]),
];
const title = isHub ? 'Agencia de SEO y GEO en LATAM: Loops Growth' : `${pais!.data.title} | Loops Growth`;
const description = isHub
  ? 'SEO y GEO para negocios de LATAM. Elige tu país y revisa lo que cambia en tu mercado.'
  : pais!.data.description;
const graph: Record<string, unknown>[] = [buildBreadcrumb(base, crumbs, `${base}${path}`)];
if (!isHub) {
  graph.push({
    '@type': 'Service',
    '@id': `${base}${path}#service`,
    name: pais!.data.h1,
    serviceType: 'SEO y GEO',
    provider: { '@id': `${base}/#organization` },
    areaServed: { '@type': 'Country', name: pais!.data.nombre },
    url: `${base}${path}`,
  });
}
const schema = { '@context': 'https://schema.org', '@graph': graph };
const paragraphs = (t: string) => t.split(/\n{2,}/).map((x) => x.trim()).filter(Boolean);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={isHub ? paises.every((p) => p.data.draft) : pais!.data.draft}
  schema={schema}
>
  <section class="pais" data-tone="light" aria-labelledby="pais-title">
    <div class="wrap">
      <nav aria-label="Ruta de navegación" class="crumbs">
        <ol>
          <li><a href="/">Inicio</a></li>
          {isHub ? <li aria-current="page">Agencia SEO</li> : <li><a href="/agencia-seo/">Agencia SEO</a></li>}
          {!isHub && <li aria-current="page">{pais!.data.nombre}</li>}
        </ol>
      </nav>
      {
        isHub ? (
          <>
            <h1 id="pais-title">Agencia de SEO y GEO en LATAM</h1>
            <ul class="pais-list" role="list">
              {paises.map((p) => (
                <li>
                  <a href={`/agencia-seo/${p.id}/`}>{p.data.h1}</a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h1 id="pais-title">{pais!.data.h1}</h1>
            <div class="prose">
              <p>{PAIS_TEMPLATE.servicio_intro.replace('{pais}', pais!.data.nombre)}</p>
              {paragraphs(pais!.data.intro).map((t) => <p>{t}</p>)}
              {pais!.data.secciones.map((s) => (
                <section>
                  <h2>{s.titulo}</h2>
                  {paragraphs(s.cuerpo).map((t) => <p>{t}</p>)}
                </section>
              ))}
              <section>
                <h2>Datos que usamos en {pais!.data.nombre}</h2>
                <ul>
                  {pais!.data.hechos.map((h) => (
                    <li>
                      {h.dato} <a href={h.fuente} rel="noopener noreferrer">Fuente</a>
                    </li>
                  ))}
                </ul>
              </section>
            </div>
            <aside class="pais-cta" aria-labelledby="pais-cta-title">
              <h2 id="pais-cta-title">{PAIS_TEMPLATE.cierre_titulo}</h2>
              <p>{PAIS_TEMPLATE.cierre_texto}</p>
              <CtaLink label={label} location="pais" href="/#agenda" />
            </aside>
            {paises.length > 1 && (
              <nav aria-label="Otros países" class="otros">
                <h2>Otros países</h2>
                <ul role="list">
                  {paises.filter((p) => p.id !== pais!.id).slice(0, 2).map((p) => (
                    <li><a href={`/agencia-seo/${p.id}/`}>{p.data.nombre}</a></li>
                  ))}
                </ul>
              </nav>
            )}
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .pais { padding-block: var(--section-y); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: var(--text-label); }
  .crumbs li + li::before { content: '/'; margin-inline-end: 0.5rem; }
  .pais h1 { max-width: 24ch; font-size: var(--text-heading); line-height: var(--text-heading--line-height); }
  .prose { max-width: 65ch; margin-top: 1.5rem; }
  .prose :global(h2) { margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .prose :global(p), .prose :global(ul) { margin-block: 1rem; }
  .prose :global(ul) { padding-inline-start: 1.5rem; list-style: disc; }
  .prose :global(li) { margin-block: 0.5rem; }
  .pais-list { display: grid; gap: 0.5rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .pais-list a, .otros a { display: inline-flex; align-items: center; min-height: var(--target-min); }
  .otros { margin-top: 2.5rem; }
  .otros ul { display: flex; flex-wrap: wrap; gap: 1rem; margin: 0.5rem 0 0; padding: 0; list-style: none; }
  .pais-cta { max-width: 65ch; margin-top: 3rem; padding: 1.5rem; border: var(--border-pop); border-radius: var(--radius-card); background: var(--color-brand-cream); box-shadow: var(--shadow-pop); }
  .pais-cta p { margin-block: 0.5rem 1rem; }
</style>
