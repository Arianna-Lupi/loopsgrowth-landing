---
/**
 * Páginas de servicio, nosotros y autora (colección `paginas`). La URL sale del campo `ruta` del YAML y cada tipo
 * tiene su propia composición (ServiceIA, AboutPage, AuthorPage). Sin páginas publicadas no se genera nada. Un
 * borrador (solo visible fuera de producción) sale `noindex`. Sin LocalBusiness, dirección ni precios.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceIA from '../components/landing/ServiceIA.astro';
import ServicePage from '../components/landing/ServicePage.astro';
import AboutPage from '../components/landing/AboutPage.astro';
import AuthorPage from '../components/landing/AuthorPage.astro';
import { getPaginas } from '../lib/paginas';
import { AREA_SERVED, buildPerson, buildPageGraph } from '../lib/seo';
import { siteUrl } from '../lib/site';

export async function getStaticPaths() {
  const paginas = await getPaginas();
  return paginas.map((pagina) => ({ params: { slug: pagina.data.ruta.slice(1, -1) }, props: { pagina } }));
}

const { pagina } = Astro.props;
const d = pagina.data;
const base = siteUrl.replace(/\/+$/, '');
const path = d.ruta;

const crumbs = [{ name: 'Inicio', path: '/' }];
if (d.tipo === 'servicio') crumbs.push({ name: 'Servicios', path: '/servicios/' });
if (d.tipo === 'autora') crumbs.push({ name: 'Nosotros', path: '/nosotros/' });
crumbs.push({ name: d.nombre, path });

const extra: Record<string, unknown>[] = [];
if (d.tipo === 'nosotros' || d.tipo === 'servicio') {
  extra.push({
    '@type': d.tipo === 'nosotros' ? 'AboutPage' : 'WebPage',
    '@id': `${base}${path}#webpage`,
    url: `${base}${path}`,
    name: d.title,
    description: d.description,
    isPartOf: { '@id': `${base}/#website` },
    about: { '@id': d.tipo === 'nosotros' ? `${base}/#organization` : `${base}${path}#service` },
    breadcrumb: { '@id': `${base}${path}#breadcrumb` },
    inLanguage: 'es',
  });
}
if (d.tipo === 'servicio') {
  extra.push({
    '@type': 'Service',
    '@id': `${base}${path}#service`,
    name: d.h1,
    serviceType: d.nombre,
    description: d.description,
    mainEntityOfPage: { '@id': `${base}${path}#webpage` },
    provider: { '@id': `${base}/#organization` },
    areaServed: AREA_SERVED,
    url: `${base}${path}`,
  });
}
if (d.tipo === 'autora' && d.persona) {
  extra.push(buildPerson({ siteUrl: base, path, nombre: d.persona.nombre, cargo: d.persona.cargo, descripcion: d.persona.descripcion, sameAs: d.persona.sameAs, conoceDe: d.persona.conoceDe }));
}
const schema = buildPageGraph(base, path, crumbs, d.faq, extra);
---

<BaseLayout reveal title={d.title} description={d.description} path={path} noindex={d.draft} schema={schema} ogType={d.tipo === 'autora' ? 'profile' : 'website'}>
  {d.tipo === 'servicio' && (d.chat && d.etapas ? <ServiceIA d={d} crumbs={crumbs} /> : <ServicePage d={d} crumbs={crumbs} />)}
  {d.tipo === 'nosotros' && <AboutPage d={d} crumbs={crumbs} />}
  {d.tipo === 'autora' && <AuthorPage d={d} crumbs={crumbs} />}
</BaseLayout>
