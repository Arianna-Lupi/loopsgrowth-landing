---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import WhyNow from '../components/sections/WhyNow.astro';
import Solution from '../components/sections/Solution.astro';
import Results from '../components/sections/Results.astro';
import Cases from '../components/sections/Cases.astro';
import Team from '../components/sections/Team.astro';
import Includes from '../components/sections/Includes.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import ForWhom from '../components/sections/ForWhom.astro';
import Faq from '../components/sections/Faq.astro';
import AgendaSection from '../components/AgendaSection.astro';
import { getLanding, fill, textVars } from '../lib/content';
import { buildLandingSchema } from '../lib/seo';
import { siteUrl } from '../lib/site';
import { getLivePaths } from '../lib/paginas';
import '../styles/reveal.css';

const data = await getLanding();
// Orden canónico de las 12 secciones (id, tono). Cada plan de la fase 2 suma la suya en este orden;
// `tests/e2e/page-structure.spec.ts` fija el mismo orden en PAGE_ORDER.
//   inicio light, problema dark, por-que-ahora yellow, solucion light, resultados dark, casos light,
//   nosotros yellow, incluye light, como-funciona dark, para-quien light, faq yellow, agenda purple.
const title = fill(data.meta.title_template, textVars(data), 'meta.title_template');
const description = data.meta.description?.text ??
  "Agencia SEO para LATAM: aparece en Google y en ChatGPT. Un equipo con 8 años de experiencia ejecuta tu SEO y tu posicionamiento en IA. Habla con nosotros.";

const baseUrl = siteUrl || 'https://loopsgrowth.com';
const pageUrl = siteUrl ? new URL('/', siteUrl).href : `${baseUrl}/`;
const live = await getLivePaths();
const authorPath = live.has('/equipo/arianna-lupi/') ? '/equipo/arianna-lupi/' : undefined;
const schema = buildLandingSchema({
  authorPath,
  data,
  siteUrl: baseUrl,
  pageUrl,
  title,
  description,
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <script slot="head" is:inline>
    // Entradas del hero: la clase oculta el hero solo hasta que reveal.js lo anima; si no llega, se retira a los 1,5 s.
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-reveal');
      setTimeout(function () { if (!window.__rvReady) document.documentElement.classList.remove('js-reveal'); }, 1500);
    }
  </script>
  <Hero />
  <Problem />
  <WhyNow />
  <Solution />
  <Results />
  <Cases />
  <Team />
  <Includes />
  <HowItWorks />
  <ForWhom />
  <AgendaSection />
  <Faq />
  <script>
    import '../scripts/reveal';
  </script>
</BaseLayout>
