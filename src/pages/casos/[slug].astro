---
/**
 * Ficha de un caso (`/casos/<slug>/`). Solo existe si el índice `/casos/` está en el build (publicado, o borrador fuera de
 * producción). Los datos salen del YAML de la home. Un borrador sale `noindex`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CasePage from '../../components/landing/CasePage.astro';
import { getPaginas } from '../../lib/paginas';
import { getLanding } from '../../lib/content';
import { CASO_SLUGS, CASOS_PATH, casoPath } from '../../lib/casos';
import { buildPageGraph } from '../../lib/seo';
import { siteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const indice = (await getPaginas()).find((p) => p.data.ruta === CASOS_PATH);
  if (!indice) return [];
  return CASO_SLUGS.map((slug, index) => ({ params: { slug }, props: { index, draft: indice.data.draft } }));
}

const { index, draft } = Astro.props;
const { slug } = Astro.params;
const data = await getLanding();
const c = data.cases.items[index];
const base = siteUrl.replace(/\/+$/, '');
const path = casoPath(slug!);
const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Resultados', path: CASOS_PATH }, { name: `${c.figure.text} ${c.metric.text}`, path }];
const title = `${c.figure.text} ${c.metric.text}: caso de ${c.sector.text} | Loops Growth`.slice(0, 70);
const description = `${c.detail?.text ?? c.metric.text} Sector: ${c.sector.text}. Plazo: ${c.period.text}.`.slice(0, 160).padEnd(70, ' ').trim();
const schema = buildPageGraph(base, path, crumbs, []);
---

<BaseLayout title={title} description={description} path={path} noindex={draft} schema={schema}>
  <CasePage index={index} crumbs={crumbs} />
</BaseLayout>
